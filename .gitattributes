# Normalize line endings: LF in the repo and on checkout, on every OS
* text=auto eol=lf

# C# / .NET
*.cs       text diff=csharp
*.csproj   text
*.props    text
*.targets  text
*.slnx     text
*.sln      text eol=crlf
*.json     text
*.xml      text
*.md       text diff=markdown
*.yml      text
*.txt      text

# Binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.dll  binary
*.exe  binary
*.zip  binary
